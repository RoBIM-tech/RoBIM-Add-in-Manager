<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RoBIM.Manager</AssemblyName>
    <ApplicationIcon>..\assets\RoBIM.Manager.ico</ApplicationIcon>
    <Version>1.1.0-test.3</Version>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <Product>RoBIM Add-in Manager</Product>
    <Description>AutoCAD 및 Revit 도구 설치 관리자</Description>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="..\Manager.Core\Manager.Core.csproj" /></ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\assets\RoBIM.Manager.ico" LogicalName="RoBIM.Manager.AppIcon.ico" />
    <Content Include="..\assets\RoBIM.Manager.ico" Link="RoBIM.Manager.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
